# ---------------------------------------------------------------- required
DOMAIN=infoharness.com
PUBLIC_BASE_URL=https://infoharness.com
# Let's Encrypt expiry notices (Caddy mode)
ACME_EMAIL=you@example.com
# deploy.sh generates a random one
POSTGRES_PASSWORD=change-me
# deploy.sh generates a random one
IP_HASH_SALT=change-me

# Database: "host" = use the server's existing PostgreSQL (own DB + user, created by deploy.sh)
#           "bundled" = private Postgres container. Empty = auto-detect.
DB_MODE=
# Filled in automatically in host mode (see scripts/provision-project.sh)
DATABASE_URL=

# "caddy" = this stack serves 80/443 with automatic HTTPS
# "none"  = you already run nginx/another proxy on 80/443 (see deploy/nginx.conf.example)
PROXY_MODE=caddy
APP_PORT=8000
TRUST_PROXY=true

# ---------------------------------------------------------------- scan limits
MAX_PAGES=300
MAX_SCAN_SECONDS=600
CRAWL_CONCURRENCY=5
SCANS_PER_IP_PER_DAY=5
MAX_QUEUE=50
CACHE_HOURS=24
CHECK_EXTERNAL_LINKS=true
MAX_LINK_CHECKS=150

# ---------------------------------------------------------------- AI (optional)
# Without a key, contradictions are found by pattern matching (numbers, prices, limits) and marked "review".
# With a key, an LLM verifies every candidate and also finds non-numeric contradictions.
# none | anthropic | openai
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_MAX_PAIRS=60

# Embeddings: tfidf (free, offline) or openai (better semantic matching; any OpenAI-compatible endpoint)
EMBEDDINGS_PROVIDER=tfidf
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

LOG_LEVEL=INFO
