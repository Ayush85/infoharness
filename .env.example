# ---------------------------------------------------------------- required
DOMAIN=infoharness.com
PUBLIC_BASE_URL=https://infoharness.com
# Let's Encrypt expiry notices (Caddy mode)
ACME_EMAIL=you@example.com
# deploy.sh generates a random one
POSTGRES_PASSWORD=change-me
# deploy.sh generates a random one
IP_HASH_SALT=change-me

# Database: "host" = use the server's existing PostgreSQL (own DB + user, created by deploy.sh)
#           "bundled" = private Postgres container. Empty = auto-detect.
DB_MODE=
# Filled in automatically in host mode (see scripts/provision-project.sh)
DATABASE_URL=

# "caddy" = this stack serves 80/443 with automatic HTTPS
# "none"  = you already run nginx/another proxy on 80/443 (see deploy/nginx.conf.example)
PROXY_MODE=caddy
APP_PORT=8000
TRUST_PROXY=true

# ---------------------------------------------------------------- scan limits
MAX_PAGES=300
MAX_SCAN_SECONDS=600
CRAWL_CONCURRENCY=5
SCANS_PER_IP_PER_DAY=5
MAX_QUEUE=50
CACHE_HOURS=24
CHECK_EXTERNAL_LINKS=true
MAX_LINK_CHECKS=150

# ---------------------------------------------------------------- AI (optional)
# Without a key, contradictions are found by pattern matching (numbers, prices, limits) and marked "review".
# With a key, an LLM verifies every candidate and also finds non-numeric contradictions.
# none | anthropic | openai
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_MAX_PAIRS=60

# Embeddings: tfidf (free, offline) or openai (better semantic matching; any OpenAI-compatible endpoint)
EMBEDDINGS_PROVIDER=tfidf
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small

# ---------------------------------------------------------------- accounts, email, plans
# Signs login cookies. deploy.sh does not generate one: without it IP_HASH_SALT is used.
SECRET_KEY=
# Login links and alerts are sent through Resend (https://resend.com) or any SMTP server. Without either, mail is only logged.
RESEND_API_KEY=
MAIL_FROM=infoharness <hello@infoharness.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated emails that always get the Pro plan
ADMIN_EMAILS=
FREE_SITES=1
PRO_SITES=5
PRO_PRICE=$19
# Hosted checkout link (Lemon Squeezy) and the signing secret of its webhook https://DOMAIN/webhooks/lemonsqueezy
CHECKOUT_URL=
LS_WEBHOOK_SECRET=

LOG_LEVEL=INFO

# Scan limits (Pro plan scans more pages and checks more links)
# PRO_MAX_PAGES=2000
# PRO_SCAN_SECONDS=1500
# PRO_MAX_LINK_CHECKS=3000
# LINK_CHECK_SECONDS=240
# SCANS_PER_USER_PER_DAY=20

# Public contact address shown on /contact, /privacy, /terms
# CONTACT_EMAIL=info@infoharness.com

# The product is free for everyone. Set true only if you later add paid plans (Free vs Pro limits).
# PAID_PLANS=false
# Free-for-all limits for signed-in users: PRO_SITES=10, PRO_MAX_PAGES=500, PRO_SCAN_SECONDS=900

# JavaScript-only docs (optional). Needs the image built with WITH_BROWSER=1 and a bigger worker: WORKER_MEM=1536m
# WITH_BROWSER=1
# RENDER_JS=true
# RENDER_MAX_PAGES=150
