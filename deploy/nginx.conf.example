# Use this when nginx already owns ports 80/443 on the server (PROXY_MODE=none).
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/infoharness.conf
#   sudo ln -s /etc/nginx/sites-available/infoharness.conf /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d infoharness.com -d www.infoharness.com
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name infoharness.com www.infoharness.com;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8730;   # must match APP_PORT in .env
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite (not append) so clients can't spoof their IP for rate limiting.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
}
